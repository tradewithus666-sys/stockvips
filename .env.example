# 複製這個檔案為 .env，填入你自己 Supabase 專案的值
# 在 Supabase Dashboard -> Project Settings -> API 可以找到

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 收款與客服（正式上線前請換成真實資料）
VITE_USDT_BEP20_ADDRESS=0xYourRealUsdtBep20Address
VITE_TELEGRAM_SUPPORT_URL=https://t.me/YourRealSupportHandle
